{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/core.async {:mvn/version "1.8.741"}
        io.github.escherize/huff {:mvn/version "0.2.21"}
        cheshire/cheshire {:mvn/version "6.1.0"}
        com.rpl/specter {:mvn/version "1.1.6"}
        org.clj-commons/hickory {:mvn/version "0.7.7"}
        fivetonine/collage {:mvn/version "0.3.0"}
        org.clj-commons/digest {:mvn/version "1.4.100"}}

 :aliases
 {:run-m {:main-opts ["-m" "fungi.main"]}
  :run-x {:ns-default fungi.main
          :exec-fn greet
          :exec-args {:name "Clojure"}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.11"}}
          :ns-default build}
  :dev {:extra-paths ["dev"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}}
                    lambdaisland/kaocha {:mvn/version "1.91.1392"}}
  :repl/conjure
    {:extra-deps {nrepl/nrepl       {:mvn/version "1.0.0"}
                  cider/cider-nrepl {:mvn/version "0.42.1"}}
     :main-opts  ["--main" "nrepl.cmdline"
                  "--middleware" "[cider.nrepl/cider-middleware]"
                  "--interactive"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.2"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  :format {:deps {dev.weavejester/cljfmt {:mvn/version "0.15.6"}}}
  :lint   {:deps {clj-kondo/clj-kondo {:mvn/version "2025.10.23"}}}
  :outdated {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}}
             :main-opts ["-m" "antq.core"]}}}
