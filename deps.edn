{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/core.async {:mvn/version "1.6.681"}
        ring/ring {:mvn/version "1.15.3"}
        metosin/reitit-ring {:mvn/version "0.9.2"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.17"}
        io.github.escherize/huff {:mvn/version "0.2.21"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1070"}
        org.postgresql/postgresql {:mvn/version "42.7.8"}
        com.zaxxer/HikariCP {:mvn/version "7.0.2"}
        aero/aero {:mvn/version "1.1.6"}
        metosin/malli {:mvn/version "0.20.0"}
        party.donut/dbxray {:mvn/version "0.0.70"}
        dev.weavejester/ragtime {:mvn/version "0.12.1"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1364"}
        ring/ring-defaults {:mvn/version "0.7.0"}}


 :aliases
 {:run-m {:main-opts ["-m" "fungi.main"]}
  :run-x {:ns-default fungi.main
          :exec-fn greet
          :exec-args {:name "Clojure"}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}
  :dev {:extra-paths ["dev"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.5.1"}}
                    lambdaisland/kaocha {:mvn/version "1.91.1392"}}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}
  :format {:deps {dev.weavejester/cljfmt {:mvn/version "0.15.3"}}}
  :lint   {:deps {clj-kondo/clj-kondo {:mvn/version "2025.10.23"}}}}}
